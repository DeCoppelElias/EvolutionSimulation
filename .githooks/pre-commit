#!/bin/sh
# The comment check reads only staged files. The docs check reads the whole docs tree, and runs
# only where the groundwork plugin puts its checker on PATH; CI always runs it.
# Enable with: git config core.hooksPath .githooks
# Bypass once with: git commit --no-verify

if ! command -v python >/dev/null 2>&1; then
    echo "pre-commit: python not found, skipping the comment and docs checks" >&2
    exit 0
fi

python tools/comment-check.py --staged || exit 1
if command -v groundwork-docs-check >/dev/null 2>&1; then
    groundwork-docs-check
fi
